{
  "expo": {
    "name": "VelaiConnect",
    "slug": "velaiconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B5FFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velaiconnect.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VelaiConnect uses your location to show jobs near you.",
        "NSPhotoLibraryUsageDescription": "VelaiConnect needs photo access to upload your profile photo or company logo."
      }
    },
    "android": {
      "package": "com.velaiconnect.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://10.1.2.145:8080/api",
      "eas": {
        "projectId": ""
      }
    }
  }
}
