# ---- Supabase PostgreSQL ----
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ---- Supabase project (service key kept server-side only) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- Supabase Storage (S3-compatible keys: Project Settings → Storage) ----
SUPABASE_S3_ENDPOINT=https://YOUR-PROJECT.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_S3_REGION=ap-south-1

# ---- JWT: generate with: openssl rand -base64 64 ----
JWT_SECRET=change-me-please-generate-a-long-random-256-bit-secret-key

# ---- OTP / SMS provider ----
# none = dev mode (OTP returned in response + printed to backend console)
# twilio | msg91 | fast2sms for production
SMS_PROVIDER=none
OTP_DEV_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# ---- Firebase Cloud Messaging (push notifications) ----
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=

# ---- CORS (mobile dev + admin panel) ----
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:5173
